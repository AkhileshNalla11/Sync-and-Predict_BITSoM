%% Glycaemic digital twin: architecture. Render with any Mermaid viewer (e.g. GitHub, mermaid.live).
%% docs/architecture.png and docs/architecture.pdf are drawn from the same structure by scripts/make_architecture_diagram.py.
flowchart LR
    subgraph DATA["1. Synthetic data (simulated, not real patients)"]
        EHR["Synthetic EHR cohort<br/>300 patients: age, BMI, HbA1c, eGFR,<br/>medications, comorbidities, ICD-10"]
        SIM["Mechanistic simulator<br/>Indian meals, insulin / SU PK, titration,<br/>sleep, activity, dawn & night effects"]
        WEAR["Wearable stream (device_id)<br/>CGM 5-min with lag, noise, dropouts;<br/>steps, heart rate, sleep stages"]
        ENR["Enrollment log<br/>patient_id to device_id<br/>(synthetic linkage)"]
        EHR -- "traits drive dynamics (by design)" --> SIM
        SIM --> WEAR
    end

    subgraph FEAT["2. Linking & features"]
        LINK["linker.py<br/>1:1 enrollment join, validated"]
        WIN["Rolling windows<br/>6 h history to 2 h horizon<br/>hyper > 180, hypo < 70, onset, nocturnal"]
        STAT["Static vector<br/>encoded EHR, scaled on train only"]
        SPLIT["Patient-level split 65/15/20<br/>stratified by drug class, leakage guard"]
    end

    subgraph MOD["3. Models"]
        PERS["Persistence<br/>trend extrapolation"]
        LGB["LightGBM per target<br/>CGM / + wearables / + EHR"]
        FUS["Fusion net (PyTorch)<br/>static MLP + GRU or 1D-CNN<br/>comparator; did not beat LightGBM"]
    end

    subgraph EVAL["4. Evaluation & real data"]
        MET["metrics.py + ablation.py<br/>AUPRC, AUROC, calibration,<br/>paired EHR-value test, patient-bootstrap CIs"]
        ALERT["alert_policy.py + subgroups.py<br/>one alert per episode, chosen on validation;<br/>audit by sex, age, eGFR, drug class"]
        BAND["twin_validation.py + twin_intervals.py<br/>held-out week; conformal 80% / 95% bands"]
        REAL["Real-data checks<br/>CGMacros 14 US: zero-shot + recalibration<br/>ShanghaiT2DM 100: real linked EHR + CGM,<br/>real-trained model, simulator realism"]
    end

    subgraph TWIN["5. Digital twin & dashboard"]
        STATE["PatientTwin (state.py)<br/>profile, 6 h history, both risks,<br/>alert-policy state"]
        EXP["explain.py<br/>TreeSHAP drivers"]
        WHAT["whatif.py + personalise.py<br/>4 parameters fitted per patient, observer,<br/>uncertainty band, ML re-prediction"]
        APP["Streamlit dashboard<br/>live replay, timeline, drivers, what-if, overview;<br/>model switch: synthetic- or real-patient-trained"]
        API["FHIR risk API (FastAPI)<br/>FHIR R4 Bundle in, RiskAssessment out"]
    end

    EHR --> LINK
    WEAR --> LINK
    ENR --> LINK
    LINK --> WIN
    EHR --> STAT
    WIN --> SPLIT
    STAT --> SPLIT
    SPLIT --> PERS
    SPLIT --> LGB
    SPLIT --> FUS
    PERS --> MET
    LGB --> MET
    FUS --> MET
    MET --> ALERT
    ALERT -. "thresholds" .-> STATE
    BAND -. "band" .-> WHAT
    LGB -- "deployed: CGM + wearables + EHR" --> STATE
    STATE --> EXP
    SIM -. "equations" .-> WHAT
    STATE --> WHAT
    STATE --> APP
    STATE --> API
    REAL -. "real-trained model" .-> STATE
    EXP --> APP
    WHAT --> APP

    classDef ehr fill:#fdebe3,stroke:#eb6834,color:#0b0b0b
    classDef sensor fill:#e3eefb,stroke:#2a78d6,color:#0b0b0b
    classDef neutral fill:#f3f2ee,stroke:#8a8984,color:#0b0b0b
    class EHR,STAT ehr
    class WEAR,WIN sensor
    classDef real fill:#e6f4f2,stroke:#0f766e,color:#0b0b0b
    class SIM,ENR,LINK,SPLIT,PERS,LGB,FUS,MET,ALERT,BAND,STATE,EXP,WHAT,APP,API neutral
    class REAL real
